---
import Hero from "../components/Hero.astro";
import Point from "../components/Point.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="mx-auto w-full max-w-6xl px-6 sm:px-8">
    <header class="py-8">
      <span class="font-display text-lg font-bold tracking-[-0.02em]">
        Dry Run
      </span>
    </header>

    <main class="pt-8 pb-24 sm:pt-14">
      <Hero />

      <section class="mt-28">
        <Point
          title="Real questions"
          description="Pulled from interviews developers actually sat, not a list of trivia someone invented to sound hard."
        />
        <Point
          title="Answered out loud"
          description="You speak the answer and hear it back. Reading a solution and explaining one are different skills, and only the second gets tested."
        />
        <Point
          title="Twelve minutes a day"
          description="Short sessions, spaced so questions return just before you'd forget them. The answer is there when someone asks."
        />
      </section>
    </main>

    <footer class="border-base-300 border-t py-8 text-sm opacity-55">
      Opening 2027. One email when it does.
    </footer>
  </div>
</Layout>
