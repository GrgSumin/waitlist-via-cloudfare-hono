---
import { Signup } from "./Signup";
---

<section class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
  <div>
    <h1 class="font-display text-5xl leading-[0.95] font-extrabold tracking-[-0.03em] text-balance sm:text-6xl lg:text-7xl">
      You know this.
      <br />
      Saying it is the hard part.
    </h1>

    <p class="mt-7 max-w-[54ch] text-lg leading-relaxed opacity-75">
      Dry Run asks you the questions you'll actually get, and makes you answer
      them out loud with a clock running — so the first time isn't the
      interview.
    </p>

    <Signup client:load />
  </div>

  <!-- A question mid-interview: the thing the product is actually about. -->
  <figure class="border-base-300 bg-base-200 rounded-box relative overflow-hidden border p-7 sm:p-9">
    <figcaption class="text-sm opacity-55">Interviewer</figcaption>

    <blockquote class="font-display mt-5 text-2xl leading-snug font-semibold text-pretty sm:text-3xl">
      &ldquo;Walk me through what happens when you type a URL and press
      enter.&rdquo;
    </blockquote>

    <div class="mt-9">
      <div class="flex items-baseline justify-between text-sm">
        <span class="opacity-55">Your turn</span>
        <span class="text-primary font-display font-semibold tabular-nums">
          0:43
        </span>
      </div>
      <div class="bg-base-300 mt-3 h-1.5 w-full overflow-hidden rounded-full">
        <div class="clock-fill bg-primary h-full w-full rounded-full"></div>
      </div>
    </div>
  </figure>
</section>
